# WTS > 설정 > Open API에서 발급받은 값
TOSS_CLIENT_ID=발급받은_client_id
TOSS_CLIENT_SECRET=발급받은_client_secret

TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_RANKING_PATH=/api/v1/rankings
TOSS_STOCKS_PATH=/api/v1/stocks

# 공식 OpenAPI 문서의 ranking parameter schema에 맞춰 확인/수정하세요.
RANKING_TYPE_PARAM=type
RANKING_MARKET_PARAM=marketCountry
RANKING_DURATION_PARAM=duration
RANKING_EXCLUDE_CAUTION_PARAM=excludeInvestmentCaution
RANKING_COUNT_PARAM=count
RANKING_MARKET=KR
RANKING_DURATION=1d
RANKING_REALTIME_DURATION=realtime
RANKING_EXCLUDE_INVESTMENT_CAUTION=false

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30
COLLECTION_INTERVAL_SECONDS=20
RANKING_COUNT=50
REQUEST_SPACING_SECONDS=0.25
HTTP_TIMEOUT_SECONDS=10
TOKEN_REFRESH_MARGIN_SECONDS=60
CORS_ORIGINS=chrome-extension://확장프로그램ID,http://localhost:3000
SECTOR_MAP_PATH=sector_map.json
WEIGHTED_ANALYSIS_ENABLED=false

# 선택 사항: 비워 두면 로컬 수치 기반 요약을 사용합니다.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL이 과부하(503)·한도 초과(429)일 때 차례로 시도할 예비 모델(쉼표 구분)
AI_FALLBACK_MODELS=
# Gemini 무료 등급 예시:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
# AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# SEC EDGAR 공시 조회용. SEC는 서비스 이름과 연락처(이메일)를 담도록 권장합니다.
# SEC_USER_AGENT=SWproject market-analysis your-email@example.com

# 두 번째 AI 제공자(예비). 첫 제공자의 모델이 모두 한도 초과·장애면 이쪽을 씁니다.
# Groq 무료 키: https://console.groq.com 의 API Keys. 모델 이름은 콘솔의 Models 목록에서 확인합니다.
AI2_API_KEY=
# AI2_BASE_URL=https://api.groq.com/openai/v1
# AI2_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# 토스증권 계좌 연결(보유 종목·주문). 계좌 식별 키(accountSeq). 비우면 첫 위탁 계좌를 씁니다.
# TOSS_ACCOUNT_SEQ=
# 실제 매수·매도 주문 허용 여부. 토스 Open API에는 모의투자가 없어 주문은 실제로 체결됩니다. 기본은 false(미리보기만).
TRADING_ENABLED=false
# 이 화면에서 한 번에 보낼 수 있는 예상 주문 금액 상한
MAX_ORDER_AMOUNT_KRW=1000000
MAX_ORDER_AMOUNT_USD=1000

# 여러 사용자 로그인. 사용자 토스 키를 암호화하는 서버 비밀값(32자 이상). 한 번 정하면 바꾸지 마세요(바꾸면 저장된 키를 못 풂).
# 만들기: py -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
SIGNUP_ENABLED=true
# 공개 서버에서는 초대 코드를 정해 두면 그 코드를 아는 사람만 가입할 수 있습니다.
SIGNUP_INVITE_CODE=
# 이 서버로 들어오는 요청의 Host 허용 목록. 공개 배포 시 도메인을 추가하세요.
ALLOWED_HOSTS=127.0.0.1,localhost
# HTTPS로 서비스할 때 true(공개 배포는 반드시 HTTPS 뒤에서 true).
SESSION_COOKIE_SECURE=false
# 기사 수집·요약·AI 분석을 새로 만드는 요청을 사용자·IP별로 10분마다 제한(로그인하면 한도가 큼). 측정할 때만 false.
RATE_LIMIT_ENABLED=true
