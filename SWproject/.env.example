# WTS > 설정 > Open API에서 발급받은 값
TOSS_CLIENT_ID=발급받은_client_id
TOSS_CLIENT_SECRET=발급받은_client_secret

TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_RANKING_PATH=/api/v1/rankings
TOSS_STOCKS_PATH=/api/v1/stocks

# 공식 OpenAPI 문서의 ranking parameter schema에 맞춰 확인/수정하세요.
RANKING_TYPE_PARAM=type
RANKING_MARKET_PARAM=marketCountry
RANKING_DURATION_PARAM=duration
RANKING_EXCLUDE_CAUTION_PARAM=excludeInvestmentCaution
RANKING_COUNT_PARAM=count
RANKING_MARKET=KR
RANKING_DURATION=1d
RANKING_REALTIME_DURATION=realtime
RANKING_EXCLUDE_INVESTMENT_CAUTION=false

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30
COLLECTION_INTERVAL_SECONDS=20
RANKING_COUNT=50
REQUEST_SPACING_SECONDS=0.25
HTTP_TIMEOUT_SECONDS=10
TOKEN_REFRESH_MARGIN_SECONDS=60
CORS_ORIGINS=chrome-extension://확장프로그램ID,http://localhost:3000
SECTOR_MAP_PATH=sector_map.json
WEIGHTED_ANALYSIS_ENABLED=false

# 선택 사항: 비워 두면 로컬 수치 기반 요약을 사용합니다.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1